{% extends 'admin.twig' %}

{% set active_section = 'pages' %}

{% block title %}Details Page Tree Demo · Neowolf{% endblock %}

{% block styles %}
    <link rel="stylesheet" href="{{ asset('assets/css/page-tree-details-demo.css') }}">
{% endblock %}

{% block content %}
    <section class="details-tree-demo">
        <header class="admin-page-header">
            <div>
                <h1>Details Page Tree Demo</h1>
                <p>
                    Experimental accessible page hierarchy using native lists,
                    details and summary elements.
                </p>
            </div>
        </header>

        <ul
                class="details-page-tree"
                id="details-page-tree"
        >
            <li>
                <details open>
                    <summary>
                        <a href="#">Home</a>
                    </summary>

                    <ul>
                        <li>
                            <details open>
                                <summary>
                                    <a href="#">About</a>
                                </summary>

                                <ul>
                                    <li>
                                        <a href="#">Team</a>
                                    </li>

                                    <li>
                                        <a href="#">History</a>
                                    </li>
                                </ul>
                            </details>
                        </li>

                        <li>
                            <details open>
                                <summary>
                                    <a href="#">News</a>
                                </summary>

                                <ul>
                                    <li>
                                        <a href="#">Local News</a>
                                    </li>

                                    <li>
                                        <a href="#">Archive</a>
                                    </li>
                                </ul>
                            </details>
                        </li>

                        <li>
                            <details open>
                                <summary>
                                    <a href="#">Events</a>
                                </summary>

                                <ul>
                                    <li>
                                        <a href="#">Workshops</a>
                                    </li>
                                </ul>
                            </details>
                        </li>

                        <li>
                            <a href="#">Contact</a>
                        </li>
                    </ul>
                </details>
            </li>
        </ul>

        <p class="details-tree-help">
            Expand and collapse page groups using their disclosure controls.
        </p>
    </section>
{% endblock %}

{% block admin_scripts %}
    <script src="{{ asset('assets/js/page-tree-details-demo.js') }}"></script>
{% endblock %}