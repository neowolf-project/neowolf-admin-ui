{% extends 'base.twig' %}

{% set active_section = 'page' %}

{% block title %}Edit {{ page.title }} · Neowolf{% endblock %}

{% block styles %}
    {{ parent() }}

    <link rel="stylesheet" href="/assets/css/page-tabs.css">
    <link rel="stylesheet" href="/assets/css/page-edit.css">
    <link rel="stylesheet" href="/assets/css/page-part-tabs.css">
{% endblock %}


{% block scripts %}
    {{ parent() }}

    <script src="/assets/js/tabs.js"></script>
    <script src="/assets/js/page-parts.js"></script>
{% endblock %}

{% block content %}
    <header class="page-header">
        <div>
            <h1>Edit Page</h1>
            <p>Manage the page content and settings.</p>
        </div>
    </header>

    <div>
        <form id="page-edit-form" class="page-edit" method="post">
            <div class="tabs" data-tabs>
                <div class="tab-list" role="tablist" aria-label="Page editor">
                    <button type="button" id="tab-content" role="tab" aria-controls="panel-content"
                            aria-selected="true" tabindex="0">
                        Page
                    </button>
                    <button type="button" id="tab-metadata" role="tab" aria-controls="panel-metadata"
                            aria-selected="false" tabindex="-1">
                        Metadata
                    </button>
                    <button type="button" id="tab-settings" role="tab" aria-controls="panel-settings"
                            aria-selected="false" tabindex="-1">
                        Settings
                    </button>
                </div>

                <div id="panel-content" role="tabpanel" aria-labelledby="tab-content">
                    <h2>Page</h2>

                    <label for="page-title">Title</label>
                    <input id="page-title" name="title" type="text" value="{{ page.title }}">
                </div>

                <div id="panel-metadata" role="tabpanel" aria-labelledby="tab-metadata" hidden>
                    <h2>Metadata</h2>

                    <div class="fields-grid">
                        <div class="field">
                            <label for="page-breadcrumb">Breadcrumb</label>
                            <input id="page-breadcrumb" name="breadcrumb" type="text"
                                   value="{{ page.breadcrumb }}">
                        </div>

                        <div class="field">
                            <label for="page-keywords">Keywords</label>
                            <input id="page-keywords" name="keywords" type="text"
                                   value="{{ page.keywords }}">
                        </div>

                        <div class="field field-span-2">
                            <label for="page-description">Description</label>
                            <textarea id="page-description" name="description"
                                      rows="4">{{ page.description }}</textarea>
                        </div>

                        <div class="field field-span-2">
                            <label for="page-labels">Labels</label>
                            <input id="page-labels" name="labels" type="text"
                                   value="{{ page.labels }}">
                        </div>
                    </div>
                </div>

                <div id="panel-settings" role="tabpanel" aria-labelledby="tab-settings" hidden>
                    <h2>Settings</h2>

                    <div class="settings-grid">
                        <fieldset class="two-column page-settings">
                            <legend>Page</legend>

                            <div class="field">
                                <label for="page-id">Page ID</label>
                                <input id="page-id" name="id" type="text" value="{{ page.id }}" readonly>
                            </div>

                            <div class="field">
                                <label for="page-parent-id">Parent ID</label>
                                <input id="page-parent-id" name="parent_id" type="text"
                                       value="{{ page.parent_id }}" readonly>
                            </div>

                            <div class="field">
                                <label for="page-layout">Layout</label>
                                <select id="page-layout" name="layout">
                                    {% for layout in ['Default', 'News', 'Article'] %}
                                        <option value="{{ layout }}"
                                                {% if page.layout == layout %}selected{% endif %}>
                                            {{ layout }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="field">
                                <label for="page-type">Page type</label>
                                <select id="page-type" name="page_type">
                                    <option value="page" {% if page.page_type == 'page' %}selected{% endif %}>Page
                                    </option>
                                    <option value="post" {% if page.page_type == 'post' %}selected{% endif %}>Post
                                    </option>
                                    <option value="product" {% if page.page_type == 'product' %}selected{% endif %}>
                                        Product
                                    </option>
                                    <option value="landing-page"
                                            {% if page.page_type == 'landing-page' %}selected{% endif %}>Landing page
                                    </option>
                                    <option value="redirect" {% if page.page_type == 'redirect' %}selected{% endif %}>
                                        Redirect
                                    </option>
                                </select>
                            </div>
                        </fieldset>

                        <fieldset class="two-column scheduling">
                            <legend>Scheduling</legend>

                            <div class="field">
                                <label for="page-created-date">Created</label>
                                <div class="inline-fields">
                                    <input id="page-created-date" name="created_date" type="date"
                                           value="{{ page.created_date }}">
                                    <input id="page-created-time" name="created_time" type="time"
                                           value="{{ page.created_time }}"
                                           aria-label="Created time">
                                </div>
                            </div>

                            <div class="field">
                                <label for="page-last-update-date">Last updated</label>
                                <div class="inline-fields">
                                    <input id="page-last-update-date" name="last_update_date" type="date"
                                           value="{{ page.last_update_date }}">
                                    <input id="page-last-update-time" name="last_update_time" type="time"
                                           value="{{ page.last_update_time }}"
                                           aria-label="Last updated time">
                                </div>
                            </div>

                            <div class="field">
                                <label for="page-published-date">Publish date</label>
                                <div class="inline-fields">
                                    <input id="page-published-date" name="published_date" type="date"
                                           value="{{ page.published_date }}">
                                    <input id="page-published-time" name="published_time" type="time"
                                           value="{{ page.published_time }}"
                                           aria-label="Publish time">
                                </div>
                            </div>

                            <div class="field">
                                <label for="page-valid-until-date">Valid until</label>
                                <div class="inline-fields">
                                    <input id="page-valid-until-date" name="valid_until_date" type="date"
                                           value="{{ page.valid_until_date }}">
                                    <input id="page-valid-until-time" name="valid_until_time" type="time"
                                           value="{{ page.valid_until_time }}"
                                           aria-label="Valid until time">
                                </div>
                            </div>
                        </fieldset>

                        <fieldset class="two-column access">
                            <legend>Access</legend>

                            <div class="field">
                                <label for="page-login">Login</label>

                                <div class="inline-fields">
                                    <select id="page-login" name="login">
                                        <option value="2" {% if page.login == 2 %}selected{% endif %}>— inherit —
                                        </option>
                                        <option value="0" {% if page.login == 0 %}selected{% endif %}>not required
                                        </option>
                                        <option value="1" {% if page.login == 1 %}selected{% endif %}>required</option>
                                    </select>

                                    <label class="checkbox-label">
                                        <input id="page-protected" name="protected" type="checkbox"
                                               {% if page.protected %}checked{% endif %}>
                                        Lock for editors
                                    </label>
                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>
            </div>

            <section class="page-parts" data-tabs aria-labelledby="page-parts-heading">
                <div class="parts-header">
                    <h3 id="page-parts-heading">Page Parts</h3>

                    <div role="group" aria-label="Page part actions" class="inline-actions">
                        <button type="button" id="add-part" class="icon-button"
                                aria-label="Add part" data-tooltip="Add part">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 5v14"/>
                                <path d="M5 12h14"/>
                            </svg>
                        </button>

                        <button type="button" id="delete-part" class="secondary icon-button"
                                aria-label="Delete part" data-tooltip="Delete part">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round" aria-hidden="true">
                                <path d="M3 6h18"/>
                                <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                <path d="M10 11v6"/>
                                <path d="M14 11v6"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <div id="parts-status" class="visually-hidden" role="status" aria-live="polite"></div>

                <div class="tab-list parts-tablist" role="tablist" aria-labelledby="page-parts-heading">
                    {% for part in page.parts %}
                        <button type="button"
                                id="tab-part-{{ loop.index0 }}"
                                role="tab"
                                aria-controls="panel-part-{{ loop.index0 }}"
                                aria-selected="{{ loop.first ? 'true' : 'false' }}"
                                tabindex="{{ loop.first ? '0' : '-1' }}">
                            {{ part.name }}
                        </button>
                    {% endfor %}
                </div>

                <div id="page-parts-panels">
                    {% for part in page.parts %}
                        <div id="panel-part-{{ loop.index0 }}"
                             role="tabpanel"
                             aria-labelledby="tab-part-{{ loop.index0 }}"
                             {% if not loop.first %}hidden{% endif %}>
                            <input id="part_{{ loop.index0 }}_name"
                                   name="part[{{ loop.index0 }}][name]"
                                   type="hidden"
                                   value="{{ part.name }}">

                            <input id="part_{{ loop.index0 }}_id"
                                   name="part[{{ loop.index0 }}][id]"
                                   type="hidden"
                                   value="{{ part.id }}">

                            <div class="field">
                                <label for="part_{{ loop.index0 }}_filter_id">Filter</label>
                                <select
                                        id="part_{{ loop.index0 }}_filter_id"
                                        class="filter-selector"
                                        name="part[{{ loop.index0 }}][filter_id]"
                                >
                                    {% for filter in filters %}
                                        <option
                                                value="{{ filter.value }}"
                                                {% if part.filter_id == filter.value %}selected{% endif %}
                                        >
                                            {{ filter.label }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>

                            <label for="part_{{ loop.index0 }}_content" class="visually-hidden">
                                Content
                            </label>
                            <textarea class="textarea markitup kubes_markdown"
                                      id="part_{{ loop.index0 }}_content"
                                      name="part[{{ loop.index0 }}][content]"
                                      rows="14"
                                      cols="40">{{ part.content }}</textarea>
                        </div>
                    {% endfor %}
                </div>
            </section>

            <footer class="form-actions" data-actions-position="left">
                <div class="form-actions-buttons">
                    <button type="submit" name="commit">Save and Close</button>
                    <button type="submit" name="continue" class="secondary">
                        Save and Continue Editing
                    </button>
                    <span>or <a href="/">Cancel</a></span>
                </div>

                <div class="status-field">
                    <label for="page-status">Status</label>
                    <select id="page-status" name="status">
                        {% for status in statuses %}
                            <option value="{{ status.value }}"
                                    {% if page.status == status.value %}selected{% endif %}>
                                {{ status.label }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
            </footer>
        </form>
    </div>

    <dialog id="add-part-dialog" aria-labelledby="add-part-dialog-title">
        <article>
            <header>
                <button type="button" aria-label="Close" rel="prev" id="close-add-part-dialog"></button>
                <h2 id="add-part-dialog-title">Add Part</h2></header>
            <form id="add-part-form" method="dialog">
                <label for="part-name-field">Name</label>
                <input id="part-name-field" name="part[name]" maxlength="100" required aria-describedby="part-name-hint">
                <small id="part-name-hint">Only lowercase letters, numbers, underscores, and hyphens; spaces become
                    hyphens.</small>
                <footer>
                    <button type="submit" id="add-part-button">Add</button>
                </footer>
            </form>
        </article>
    </dialog>
    <dialog id="delete-part-dialog" aria-labelledby="delete-part-dialog-title" aria-describedby="delete-part-message">
        <article>
            <header>
                <button type="button" aria-label="Close" rel="prev" id="close-delete-part-dialog"></button>
                <h2 id="delete-part-dialog-title">Delete Part</h2></header>
            <p id="delete-part-message">Are you sure you want to delete this page part?</p>
            <footer>
                <button type="button" id="cancel-delete-part" class="secondary">Cancel</button>
                <button type="button" id="confirm-delete-part">Delete</button>
            </footer>
        </article>
    </dialog>
{% endblock %}
