{% extends 'base.twig' %}

{% block title %}Login · Neowolf{% endblock %}

{% block styles %}
    {{ parent() }}

    <link rel="stylesheet" href="{{ asset('assets/css/auth.css') }}">
{% endblock %}

{% block body %}
    <header class="admin-header">
        <p class="admin-brand">
            <a href="/">Neowolf</a>
        </p>

        <div class="admin-header-actions">
            {% include 'partials/theme-toggle.twig' %}
        </div>
    </header>

    <main class="auth-main" id="main-content">
        <div class="auth-container">
            <header class="auth-header">
                <h1>Login</h1>
                <p>Log in to continue.</p>
            </header>

            <form>
                <input
                        type="text"
                        name="login"
                        placeholder="Username"
                        aria-label="Username"
                        autocomplete="username"
                        required
                >

                <input
                        type="password"
                        name="password"
                        placeholder="Password"
                        aria-label="Password"
                        autocomplete="current-password"
                        required
                >

                <button type="submit">
                    Login
                </button>

                <div class="auth-actions">
                    <a href="/auth/forgot">
                        Forgot password?
                    </a>
                </div>
            </form>
        </div>
    </main>
{% endblock %}