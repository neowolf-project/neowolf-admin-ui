<nav aria-label="Administration">

    {% for group in navigation %}

        {% if group.section %}
            <h2 class="nav-section">{{ group.section }}</h2>
        {% endif %}

        <ul>
            {% for item in group.items %}
                <li>
                    <a
                        href="{{ item.href|default('#', true) }}"
                        {% if active_section|default('') == item.id %}
                            aria-current="page"
                        {% endif %}
                    >
                        <span class="nav-icon" aria-hidden="true">
                            <img
                                src="/assets/icons/plugins/{{ item.icon }}"
                                alt=""
                            >
                        </span>

                        <span class="nav-label">
                            {{ item.label }}
                        </span>
                    </a>
                </li>
            {% endfor %}
        </ul>

    {% endfor %}

</nav>