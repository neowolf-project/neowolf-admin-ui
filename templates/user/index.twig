{% extends 'admin.twig' %}

{% set active_section = 'user' %}

{% block title %}Users · Neowolf{% endblock %}

{% block styles %}
    {{ parent() }}

    <link rel="stylesheet" href="{{ asset('assets/css/flat-list.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/user.css') }}">
{% endblock %}

{% block content %}
    <section class="user" data-plugin-id="user">
        <header class="admin-page-header">
            <h1>Users</h1>

            <div class="admin-page-actions">
                <a
                        href="/user/add"
                        class="admin-button admin-toolbar-button"
                        aria-label="Add user"
                        data-tooltip="Add user"
                        data-placement="top"
                >
                    <svg
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                            focusable="false"
                    >
                        <path d="M12 5v14M5 12h14"/>
                    </svg>
                </a>

                <button
                        type="button"
                        class="secondary admin-toolbar-button"
                        data-sortable-toggle="user-index"
                        aria-pressed="false"
                        aria-label="Enable reorder"
                        aria-keyshortcuts="Alt+Shift+R"
                        aria-describedby="user-reorder-help"
                        data-tooltip="Enable reorder (Alt+Shift+R)"
                        data-placement="top"
                >
                    <svg
                            class="icon-reorder"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                            focusable="false"
                    >
                        <path d="M12 3v18M8 7l4-4 4 4M8 17l4 4 4-4"/>
                    </svg>

                    <svg
                            class="icon-reorder-active"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                            focusable="false"
                    >
                        <path d="M12 2v20M2 12h20"/>
                        <path d="m8 6 4-4 4 4"/>
                        <path d="m8 18 4 4 4-4"/>
                        <path d="m6 8-4 4 4 4"/>
                        <path d="m18 8 4 4-4 4"/>
                    </svg>
                </button>
            </div>
        </header>

        <p
                id="user-reorder-help"
                class="admin-index-reorder-help"
        >
            Reorder: drag an item, or press Alt+Shift+R and use the arrow keys.
            Press Space to pick up and place an item; Escape cancels and exits reorder mode.
        </p>

        <div
                id="user-index"
                class="admin-index users-grid"
                data-sortable-flat-tree
        >
            <div
                    class="users-header"
                    aria-hidden="true"
            >
                <span>User</span>
                <span>Email</span>
                <span>Roles</span>
                <span>Actions</span>
            </div>

            <div
                    class="admin-index-list"
                    data-sortable-list
                    role="list"
                    aria-label="Users"
            >
                {% for user in users %}
                    <div
                            id="user_{{ user.id }}"
                            class="user-row"
                            data-sortable-item
                            data-id="{{ user.id }}"
                            role="listitem"
                    >
                        <div class="user-info">
                            <a
                                    href="/user/edit/{{ user.id }}"
                                    class="user-name"
                                    data-sortable-label
                            >
                                {{ user.name }}
                            </a>

                            <small>{{ user.username }}</small>
                        </div>

                        <div class="user-email">
                            <span class="user-label">Email</span>

                            <a href="mailto:{{ user.email }}">
                                {{ user.email }}
                            </a>
                        </div>

                        <div class="user-roles">
                            <span class="user-label">Roles</span>
                            <span>{{ user.roles|join(', ') }}</span>
                        </div>

                        <div class="user-actions">
                            <span class="user-label">Actions</span>

                            <div class="user-action-list">
                                <button
                                        type="button"
                                        class="icon-button delete"
                                        aria-label="{{ user.protected
                                        ? 'Delete unavailable for ' ~ user.name
                                        : 'Delete ' ~ user.name
                                        }}"
                                        {% if not user.protected %}
                                            data-tooltip="Delete"
                                            data-placement="top"
                                            data-delete-user="{{ user.id }}"
                                            data-delete-name="{{ user.name }}"
                                        {% endif %}
                                        {% if user.protected %}
                                            disabled
                                        {% endif %}
                                >
                                    <svg
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            aria-hidden="true"
                                            focusable="false"
                                    >
                                        <path d="M3 6h18"/>
                                        <path d="M8 6V4h8v2"/>
                                        <path d="M19 6l-1 14H6L5 6"/>
                                        <path d="M10 11v5"/>
                                        <path d="M14 11v5"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            {% if users is empty %}
                <p class="users-empty">
                    No users found.
                </p>
            {% endif %}

            <div
                    class="admin-index-reorder-status visually-hidden"
                    role="status"
                    aria-live="polite"
                    aria-atomic="true"
            ></div>
        </div>
    </section>
{% endblock %}

{% block scripts %}
    {{ parent() }}

    <script src="{{ asset('assets/js/sortable.min.js') }}"></script>
    <script src="{{ asset('assets/js/tree-helpers.js') }}"></script>
    <script src="{{ asset('assets/js/sortable-flat-tree.js') }}"></script>
{% endblock %}