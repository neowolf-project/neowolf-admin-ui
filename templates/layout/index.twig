{% extends 'admin.twig' %}

{% set active_section = 'layout' %}

{% block title %}Layouts · Neowolf{% endblock %}

{% block styles %}
    {{ parent() }}

    <link rel="stylesheet" href="{{ asset('assets/css/flat-list.css') }}">
{% endblock %}

{% block content %}
    <section class="layout" data-plugin-id="layout">
        <header class="admin-page-header">
            <h1>Layouts</h1>

            <div class="layout-actions">
                <a
                        href="/layout/add"
                        class="admin-button admin-toolbar-button"
                        aria-label="Add layout"
                        data-tooltip="Add layout"
                        data-placement="top"
                >
                    <svg
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                            focusable="false"
                    >
                        <path d="M12 5v14M5 12h14"/>
                    </svg>
                </a>

                <button
                        type="button"
                        class="secondary admin-toolbar-button"
                        data-sortable-toggle="layout-index"
                        aria-pressed="false"
                        aria-label="Enable reorder"
                        aria-keyshortcuts="Alt+Shift+R"
                        aria-describedby="layout-reorder-help"
                        data-tooltip="Enable reorder (Alt+Shift+R)"
                        data-placement="top"
                >
                    <svg
                            class="icon-reorder"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                            focusable="false"
                    >
                        <path d="M12 3v18M8 7l4-4 4 4M8 17l4 4 4-4"/>
                    </svg>

                    <svg
                            class="icon-reorder-active"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                            focusable="false"
                    >
                        <path d="M12 2v20M2 12h20"/>
                        <path d="m8 6 4-4 4 4"/>
                        <path d="m8 18 4 4 4-4"/>
                        <path d="m6 8-4 4 4 4"/>
                        <path d="m18 8 4 4-4 4"/>
                    </svg>
                </button>
            </div>
        </header>

        <p
                id="layout-reorder-help"
                class="admin-index-reorder-help"
        >
            Reorder: drag an item, or press Alt+Shift+R and use the arrow keys.
            Press Space to pick up and place an item; Escape cancels and exits reorder mode.
        </p>

        <div
                id="layout-index"
                class="admin-index"
                data-sortable-flat-tree
        >
            <div
                    class="admin-index-header"
                    aria-hidden="true"
            >
                <div class="admin-index-cell">
                    Layout
                </div>

                <div class="admin-index-cell admin-index-actions">
                    Actions
                </div>
            </div>

            <ul
                    id="layouts"
                    class="admin-index-list"
                    data-sortable-list
                    aria-label="Layouts"
            >
                {% for layout in layouts %}
                    <li
                            id="layout_{{ layout.id }}"
                            class="admin-index-row"
                            data-sortable-item
                            data-id="{{ layout.id }}"
                            data-layout-name="{{ layout.name }}"
                            data-is-protected="{{ layout.protected ? '1' : '0' }}"
                    >
                        <div class="admin-index-cell admin-index-main">
                            <a
                                    href="/layout/edit/{{ layout.id }}"
                                    data-sortable-label
                            >
                                {{ layout.name }}
                            </a>
                        </div>

                        <div class="admin-index-cell admin-index-actions">
                            <button
                                    type="button"
                                    class="icon-button delete"
                                    aria-label="Delete layout {{ layout.name }}"
                                    data-tooltip="Delete"
                                    data-placement="left"
                            >
                                <svg
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        aria-hidden="true"
                                        focusable="false"
                                >
                                    <path d="M3 6h18"/>
                                    <path d="M8 6V4h8v2"/>
                                    <path d="M19 6l-1 14H6L5 6"/>
                                    <path d="M10 11v5"/>
                                    <path d="M14 11v5"/>
                                </svg>
                            </button>
                        </div>
                    </li>
                {% else %}
                    <li class="admin-index-row">
                        <div class="admin-index-cell admin-index-main">
                            No layouts found.
                        </div>
                    </li>
                {% endfor %}
            </ul>

            <div
                    class="admin-index-reorder-status visually-hidden"
                    role="status"
                    aria-live="polite"
                    aria-atomic="true"
            ></div>
        </div>
    </section>
{% endblock %}

{% block scripts %}
    {{ parent() }}

    <script src="{{ asset('assets/js/sortable.min.js') }}"></script>
    <script src="{{ asset('assets/js/tree-helpers.js') }}"></script>
    <script src="{{ asset('assets/js/sortable-flat-tree.js') }}"></script>
    <script src="{{ asset('assets/js/layout-index.js') }}"></script>
{% endblock %}