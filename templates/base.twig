<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}Neowolf{% endblock %}</title>

    <script>
        /* Apply the saved theme before CSS renders to prevent a theme flash. */
        try {
            const storedTheme = localStorage.getItem('neowolf-color-scheme');

            if (storedTheme === 'light' || storedTheme === 'dark') {
                document.documentElement.setAttribute('data-theme', storedTheme);
            }
        } catch {
            // Ignore unavailable or blocked localStorage.
        }
    </script>

    <link rel="stylesheet" href="{{ asset('assets/css/blades.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/neowolf.css') }}">

    {% block styles %}{% endblock %}
</head>

<body id="top">

{% block body %}{% endblock %}

<script src="{{ asset('assets/js/neowolf.js') }}"></script>
<script src="{{ asset('assets/js/theme.js') }}"></script>

{% block scripts %}{% endblock %}

</body>
</html>